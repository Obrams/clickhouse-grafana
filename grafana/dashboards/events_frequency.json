          "queryType": "sql",
          "rawSql": "-- Частота событий по дням\n-- Группирует все события по дням и подсчитывает их количество\nSELECT \n    toDate(event_time) AS day,\n    count() AS events_count\nFROM web_events\nWHERE $__timeFilter(event_time)\nGROUP BY day\nORDER BY day",
          "refId": "A"
        }
      ],
      "title": "События по дням",
      "type": "timeseries"
