      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse_ds"
          },
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "-- Общая статистика ошибок\n-- Вычисляет процент ошибок от общего количества событий\nSELECT \n    countIf(error_type != '') AS total_errors,\n    count() AS total_events,\n    (total_errors / total_events) * 100 AS error_rate_percent\nFROM web_events\nWHERE $__timeFilter(event_time)",
          "refId": "A"
        }
      ],
      "title": "Статистика ошибок",
      "type": "stat"
    },
