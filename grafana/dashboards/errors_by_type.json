          },
          "queryType": "sql",
          "rawSql": "-- Распределение ошибок по типам\n-- Фильтрует только записи с ошибками (error_type != '')\n-- Подсчитывает количество каждого типа ошибки\nSELECT \n    error_type,\n    count() AS error_count\nFROM web_events\nWHERE $__timeFilter(event_time)\n  AND error_type != ''\nGROUP BY error_type\nORDER BY error_count DESC",
          "refId": "A"
        }
      ],
      "title": "Распределение ошибок по типам",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse_ds"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
