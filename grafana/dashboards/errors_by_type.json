            }
          },
          "queryType": "sql",
          "rawSql": "-- Топ пользователей с ошибками\n-- groupArray собирает все типы ошибок пользователя в массив\n-- LIMIT 10 показывает только топ-10 проблемных пользователей\nSELECT \n    user_id,\n    count() AS error_count,\n    groupArray(error_type) AS error_types\nFROM web_events\nWHERE $__timeFilter(event_time)\n  AND error_type != ''\nGROUP BY user_id\nORDER BY error_count DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Топ пользователей с ошибками",
      "type": "table"
    }
