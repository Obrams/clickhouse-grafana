            }
          },
          "queryType": "sql",
          "rawSql": "-- Ошибки по времени и типу\n-- Группировка по минутам для детального мониторинга\n-- Каждый тип ошибки отображается отдельной линией\nSELECT \n    toStartOfMinute(event_time) AS time,\n    error_type,\n    count() AS count\nFROM web_events\nWHERE $__timeFilter(event_time)\n  AND error_type != ''\nGROUP BY time, error_type\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Динамика ошибок по типам",
      "type": "timeseries"
    },
