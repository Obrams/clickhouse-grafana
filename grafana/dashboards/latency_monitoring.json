            }
          },
          "queryType": "sql",
          "rawSql": "-- Распределение latency (гистограмма)\n-- floor(latency / 100) * 100 создает \"корзины\" по 100 мс\n-- например: 0-99 -> 0, 100-199 -> 100, 200-299 -> 200 и т.д.\nSELECT \n    floor(latency / 100) * 100 AS latency_bucket,\n    count() AS count\nFROM web_events\nWHERE $__timeFilter(event_time)\nGROUP BY latency_bucket\nORDER BY latency_bucket",
          "refId": "A"
        }
      ],
      "title": "Распределение Latency (гистограмма)",
