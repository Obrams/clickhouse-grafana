              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "-- Текущие метрики latency за последний час\nSELECT \n    avg(latency) AS avg_latency,\n    quantile(0.95)(latency) AS p95_latency,\n    quantile(0.99)(latency) AS p99_latency,\n    max(latency) AS max_latency\nFROM web_events\nWHERE event_time >= now() - INTERVAL 1 HOUR",
          "refId": "A"
        }
      ],
      "title": "Текущие метрики Latency (последний час)",
      "type": "stat"
    },
