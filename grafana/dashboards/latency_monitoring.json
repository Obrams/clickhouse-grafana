      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse_ds"
          },
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "-- Метрики latency по часам\n-- avg() - средняя латентность\n-- quantile(0.95) - 95-й перцентиль (латентность для 95% запросов)\n-- max() - максимальная латентность (outliers)\nSELECT \n    toStartOfHour(event_time) AS time,\n    avg(latency) AS avg_latency,\n    quantile(0.95)(latency) AS p95_latency,\n    max(latency) AS max_latency\nFROM web_events\nWHERE $__timeFilter(event_time)\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Latency по часам (Avg / P95 / Max)",
      "type": "timeseries"
    },
