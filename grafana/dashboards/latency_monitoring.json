          },
          "queryType": "sql",
          "rawSql": "-- Топ пользователей по средней латентности\n-- HAVING requests_count > 10 фильтрует пользователей с малым количеством запросов\n-- чтобы избежать искажения статистики единичными медленными запросами\nSELECT \n    user_id,\n    avg(latency) AS avg_latency,\n    count() AS requests_count\nFROM web_events\nWHERE $__timeFilter(event_time)\nGROUP BY user_id\nHAVING requests_count > 10\nORDER BY avg_latency DESC\nLIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Топ пользователей по Latency",
      "type": "table"
    },
