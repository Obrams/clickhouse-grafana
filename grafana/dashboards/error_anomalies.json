          "queryType": "sql",
          "rawSql": "-- Тепловая карта ошибок по часам и дням недели\n-- Позволяет выявить паттерны: в какое время и дни недели ошибок больше\nSELECT \n    toStartOfHour(event_time) AS time,\n    toDayOfWeek(event_time) AS day_of_week,\n    countIf(error_type != '') AS error_count\nFROM web_events\nWHERE $__timeFilter(event_time)\nGROUP BY time, day_of_week\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Тепловая карта ошибок (по часам и дням недели)",
