      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse_ds"
          },
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "-- Текущая частота ошибок за разные временные интервалы\n-- Позволяет быстро оценить состояние системы\nSELECT \n    (countIf(error_type != '' AND event_time >= now() - INTERVAL 5 MINUTE) / \n     countIf(event_time >= now() - INTERVAL 5 MINUTE)) * 100 AS error_rate_5min,\n    (countIf(error_type != '' AND event_time >= now() - INTERVAL 15 MINUTE) / \n     countIf(event_time >= now() - INTERVAL 15 MINUTE)) * 100 AS error_rate_15min,\n    (countIf(error_type != '' AND event_time >= now() - INTERVAL 1 HOUR) / \n     countIf(event_time >= now() - INTERVAL 1 HOUR)) * 100 AS error_rate_1hour\nFROM web_events",
          "refId": "A"
        }
      ],
      "title": "Текущая частота ошибок (5мин / 15мин / 1час)",
      "type": "stat"
    },
