          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": 100,
              "mode": "list"
            }
          },
          "queryType": "sql",
          "rawSql": "-- Количество ошибок в минуту и процент от общего числа событий\n-- countIf(error_type != '') подсчитывает только записи с ошибками\n-- error_rate_percent показывает процент ошибок, что важно для алертинга\nSELECT \n    toStartOfMinute(event_time) AS time,\n    countIf(error_type != '') AS error_count,\n    count() AS total_count,\n    (error_count / total_count) * 100 AS error_rate_percent\nFROM web_events\nWHERE $__timeFilter(event_time)\nGROUP BY time\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Ошибки в минуту (количество и процент)",
      "type": "timeseries"
    },
