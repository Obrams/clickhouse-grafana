          },
          "queryType": "sql",
          "rawSql": "-- Сравнение с предыдущим периодом\n-- Использует оконные функции для получения значений предыдущего часа\n-- Помогает выявить аномальные всплески ошибок\nWITH hourly_errors AS (\n    SELECT \n        toStartOfHour(event_time) AS hour,\n        countIf(error_type != '') AS error_count\n    FROM web_events\n    WHERE $__timeFilter(event_time)\n    GROUP BY hour\n)\nSELECT \n    hour AS time,\n    error_count AS errors_current,\n    lagInFrame(error_count, 1, 0) OVER (ORDER BY hour) AS errors_previous\nFROM hourly_errors\nORDER BY hour",
          "refId": "A"
        }
      ],
      "title": "Сравнение ошибок с предыдущим часом",
      "type": "timeseries"
    },
